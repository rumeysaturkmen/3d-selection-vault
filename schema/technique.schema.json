{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "technique.schema.json",
  "title": "3D selection technique",
  "description": "One file per technique in data/techniques/<id>.json. Attribute values are checked against schema/attributes.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "primaryTask", "tasks", "attributes", "publications", "review"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "description": "Must match the file name." },
    "name": { "type": "string", "minLength": 1 },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "year": { "type": ["integer", "null"], "minimum": 1960, "maximum": 2100, "description": "Year of the earliest publication that introduces the technique." },
    "summary": { "type": "string", "minLength": 1, "description": "One sentence." },
    "howItWorks": { "type": "string" },
    "advantages": { "type": "array", "items": { "type": "string" } },
    "limitations": { "type": "array", "items": { "type": "string" } },
    "primaryTask": { "enum": ["selection", "manipulation", "system-control", "navigation"] },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "contains": { "const": "selection" },
      "items": { "enum": ["selection", "manipulation", "system-control", "navigation"] }
    },
    "attributes": {
      "type": "object",
      "description": "Keys and values are defined in schema/attributes.json.",
      "additionalProperties": { "type": "array", "items": { "type": "string" }, "uniqueItems": true }
    },
    "tags": { "type": "array", "items": { "type": "string" } },
    "media": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["type", "url"],
        "properties": {
          "type": { "enum": ["image", "video", "demo", "code"] },
          "url": { "type": "string", "pattern": "^https?://" },
          "caption": { "type": "string" }
        }
      }
    },
    "publications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["publication", "role"],
        "properties": {
          "publication": { "type": "string", "description": "Id of a file in data/publications/." },
          "role": { "enum": ["introduced", "evaluated", "surveyed", "reference"] },
          "where": { "type": "string", "description": "Section or page in that publication." }
        }
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["technique", "type"],
        "properties": {
          "technique": { "type": "string", "description": "Id of another technique." },
          "type": { "enum": ["extends", "variant-of", "compared-with", "related"] },
          "source": { "type": "string", "description": "Id of the publication that supports this link." },
          "note": { "type": "string" }
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": { "enum": ["migrated", "draft", "reviewed"] },
        "reviewedBy": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
