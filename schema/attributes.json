{
  "$comment": "Attribute scheme 1.0 for 3D selection techniques (roadmap step 2). Selection tool, tool origin, motor and visual space and disambiguation follow Argelaguet & Andujar (2013); the rest are additions. This file is the single source of truth: the data validator and the website both read it. Changing a value id means updating every technique that uses it.",
  "status": "1.0",
  "attributes": [
    {
      "id": "environment",
      "label": "Environment",
      "description": "Where the technique was built and tested: a VR headset, AR or mixed reality (head-worn or handheld), a desktop or fish-tank monitor, a projection-based or large display (CAVE, workbench, wall), or a volumetric display.",
      "basis": "Vault addition",
      "multiple": true,
      "weight": 1,
      "values": [
        {
          "id": "vr",
          "label": "VR (head-mounted display)"
        },
        {
          "id": "ar",
          "label": "AR / mixed reality"
        },
        {
          "id": "desktop",
          "label": "Desktop / fish tank"
        },
        {
          "id": "projection",
          "label": "CAVE, projection or large display"
        },
        {
          "id": "volumetric",
          "label": "Volumetric display"
        }
      ]
    },
